<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Firebase needs network access. The debug and profile manifests declare
         this separately for the Flutter tool, so without it here release builds
         would be the only variant lacking it. Firebase's own manifests happen to
         merge it in today, but declaring it explicitly is what actually
         guarantees it. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Reminders are local alarms. Android drops scheduled alarms across a
         reboot, so the notification plugin re-arms them from its own boot
         receiver below; without this permission that receiver never runs and
         every pending reminder is silently lost. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 13+ runtime permission. Declared here, but requested only at
         the moment the user creates their first reminder — never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Deliberately NOT declared: SCHEDULE_EXACT_ALARM and USE_EXACT_ALARM.
         A reminder about a bill does not need second-perfect delivery, and
         those permissions are audited by app stores and (for
         SCHEDULE_EXACT_ALARM) revocable by the user at any time. Reminders are
         scheduled with AndroidScheduleMode.inexactAllowWhileIdle, which needs
         neither, at the cost of delivery that Android may shift by a few
         minutes under battery/idle policy. -->

    <application
        android:label="Action"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Shows a scheduled reminder when its alarm fires. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Re-arms scheduled reminders after a reboot or an app update, which
             Android otherwise discards. MY_PACKAGE_REPLACED covers the update
             case; the QUICKBOOT actions cover OEM fast-boot variants. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
