<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Firebase needs network access. The debug and profile manifests declare
         this separately for the Flutter tool, so without it here release builds
         would be the only variant lacking it. Firebase's own manifests happen to
         merge it in today, but declaring it explicitly is what actually
         guarantees it. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Reminders are local alarms. Android drops scheduled alarms across a
         reboot, so the notification plugin re-arms them from its own boot
         receiver below; without this permission that receiver never runs and
         every pending reminder is silently lost. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 13+ runtime permission. Declared here, but requested only at
         the moment the user creates their first reminder — never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Firebase Analytics brings these in by default so an app can attribute
         installs and build ad audiences. Action does neither: Day 18's
         analytics is a closed catalogue of content-free counts, there is no
         advertising, no attribution and no audience anywhere in the product.
         Left in place they would oblige a Play Data Safety declaration that
         this app collects an advertising identifier, which would simply not
         be true. Removed here and switched off in the SDK below, so the
         declaration and the binary agree. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <!-- App Lock. Declared so BiometricPrompt can offer a fingerprint or face
         where the device has one; the device PIN, pattern or password is the
         fallback and needs no permission. Action never receives the biometric
         itself - it asks the OS whether the owner is present and is told yes
         or no. Nothing about a fingerprint or a face is stored by this app. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Deliberately NOT declared: SCHEDULE_EXACT_ALARM and USE_EXACT_ALARM.
         A reminder about a bill does not need second-perfect delivery, and
         those permissions are audited by app stores and (for
         SCHEDULE_EXACT_ALARM) revocable by the user at any time. Reminders are
         scheduled with AndroidScheduleMode.inexactAllowWhileIdle, which needs
         neither, at the cost of delivery that Android may shift by a few
         minutes under battery/idle policy. -->

    <application
        android:label="Action"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Shows a scheduled reminder when its alarm fires. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Re-arms scheduled reminders after a reboot or an app update, which
             Android otherwise discards. MY_PACKAGE_REPLACED covers the update
             case; the QUICKBOOT actions cover OEM fast-boot variants. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- The other half of removing the AD_ID permission above: without
             this the SDK would still try to read an advertising id it no
             longer has permission for. Analytics events are unaffected. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Firebase ships a ContentProvider that initialises the default
             FirebaseApp during process creation, before Android has even
             constructed the Activity and long before Dart runs. It is a
             convenience for apps that never call initializeApp themselves.
             This app always has: main() calls Firebase.initializeApp with
             explicit options, so the provider's only effect here was to do
             the same work earlier, on the critical path to the first frame.

             Day 16 measured it as the largest remaining pre-frame cost that
             Dart could not reorder. Day 17 measured removing it, six cold
             starts each way on the API-36 emulator:

               with the provider:    1809 1916 1924 1948 2006 2067  (~1936 ms)
               without it:           1283 1319 1391 1398 1483 1497  (~1395 ms)

             ~540 ms, and not one run in the second set was slower than any
             run in the first. Verified afterwards on device: the default
             FirebaseApp initialises, Crashlytics starts and fetches its
             settings, App Check's debug provider activates, anonymous auth
             succeeds and a pending outbox of Action mirrors drains to zero -
             which it can only do if auth, App Check and Firestore all work.

             The trade, stated honestly: Crashlytics now starts when Dart asks
             for it rather than at process creation, so a *native* crash in
             the first few hundred milliseconds would go unreported. Dart
             errors are unaffected - main() installs its handlers before
             anything else can fail, and they defer until FirebaseGate opens.

             If a future Firebase library genuinely requires provider-time
             initialisation, deleting this block restores the default. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
