  "privacyWillTryAgain": "Action will try again.",
  "privacyCloudCheckIncomplete": "Action could not finish checking the cloud, and will try again.",
  "privacyLeftoverCaptures": "some captures",
  "privacyLeftoverCloudRecords": "{count, plural, =1{1 cloud record} other{{count} cloud records}}",
  "@privacyLeftoverCloudRecords": {
