  },
  "authenticitySignalFile": "File",
  "@authenticitySignalFile": {
    "description": "Label of the row shown when the bytes could not be inspected at all. Its value is either authenticitySignalFileUnreadableValue or authenticitySignalFileUnrecognisedValue."
