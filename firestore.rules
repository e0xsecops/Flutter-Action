rules_version = '2';

// Deny-by-default. The ONLY reachable path is a user's own action mirror:
//
//   users/{uid}/actions/{actionId}
//
// written by the authenticated (anonymous) user whose uid owns the path.
// Every other document in the database is unreachable by clients.
//
// Deploy: Firebase Console -> Firestore -> Rules (paste), or
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/actions/{actionId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidActionMirror(actionId);
      // Day 14 opens exactly one door: the owner may delete their own mirror
      // documents, because "delete all my data" has to be able to mean it.
      // Nothing else changes — no listing, no cross-user access, and no
      // validation is relaxed on create or update. A delete needs only
      // ownership, since there is no payload to check when the outcome is
      // that the document stops existing.
      allow delete: if isOwner(uid);
    }

    // Everything else: unreachable. (Firestore denies by default; this makes
    // the posture explicit and survives future top-level matches.)
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The exact Day-8 mirror payload, and nothing else: unknown fields are
    // rejected, the embedded id must match the document id, and the small
    // enums are closed sets. Optional fields may be null but must exist as
    // keys (the client always writes the full shape).
    function isValidActionMirror(actionId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'id', 'title', 'status', 'urgency', 'category',
          'due', 'dueIsDateOnly', 'amountMinorUnits', 'currency',
          'recommendedNextStep', 'origin',
          'createdAt', 'updatedAt', 'completedAt', 'archivedAt',
        ])
        && d.schemaVersion == 1
        && d.id == actionId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['active', 'completed', 'archived']
        && d.origin in ['extraction', 'manual']
        && d.createdAt is string
        && d.updatedAt is string
        && (d.due == null || d.due is string)
        && (d.amountMinorUnits == null || d.amountMinorUnits is int)
        && (d.currency == null || (d.currency is string && d.currency.size() == 3));
    }
  }
}
